# =============================================================================
# KASMS Nginx Server Configuration — NGINX_TLS_MODE=standalone
#
# ${DOMAIN} is substituted at container startup by scripts/nginx-entrypoint.sh.
#
# This nginx terminates TLS itself — used for boxes with no edge proxy in
# front (e.g. a test server reached directly at https://<its-IP>, using a
# self-signed cert). Certs are expected at the same path certbot would use:
# /etc/letsencrypt/live/${DOMAIN}/{fullchain,privkey}.pem — for a self-signed
# cert, just drop files there manually in that shape; for a real cert, the
# ACME challenge location below lets certbot (run separately) renew it.
# =============================================================================

# ── HTTP: redirect + ACME challenge ──────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS: main server ───────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    resolver                  8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout          5s;

    # HSTS belongs here (not in the shared locations file) because nginx
    # itself is the TLS-terminating layer for browsers in this mode.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    set $forwarded_proto $scheme;
    set $forwarded_for   $remote_addr;

    include /etc/nginx/includes/kasms-locations.conf;
}

# =============================================================================
# KASMS — Environment Variables Example
# Copy to .env and fill in your values:  cp .env.example .env
# NEVER commit .env — it is gitignored.
# =============================================================================

# ── Core ──────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(60))">

# ── Domain / IP ───────────────────────────────────────────────────────────────
DOMAIN=192.168.2.254

# IMPORTANT: On the production server, ALLOWED_HOSTS must include the backend
# container name (kasms-backend-1) so Prometheus can scrape /metrics without
# getting HTTP 400 Bad Request from Django's host header validation.
ALLOWED_HOSTS=192.168.2.254,localhost,127.0.0.1,kasms-backend-1

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=kasms_db
DB_USER=kasms_user
DB_PASSWORD=<strong-password>
HOST=db
PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<strong-password>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@redis:6379/0

# ── Frontend (baked into nginx image at build time) ───────────────────────────
VITE_API_URL=https://192.168.2.254
VITE_APP_NAME=KASMS

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://192.168.2.254
CSRF_TRUSTED_ORIGINS=https://192.168.2.254
COOKIE_DOMAIN=192.168.2.254

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_HOST_USER=kasmsmanagement@gmail.com
EMAIL_HOST_PASSWORD=<gmail-app-password>
DEFAULT_FROM_EMAIL=kasmsmanagement@gmail.com

# ── 2FA ───────────────────────────────────────────────────────────────────────
TWO_FA_CODE_LENGTH=6
TWO_FA_CODE_EXPIRY_MINUTES=5
TWO_FA_MAX_ATTEMPTS=5

# ── SSL ───────────────────────────────────────────────────────────────────────
CERTBOT_EMAIL=kasmsmanagement@gmail.com
CERTBOT_STAGING=0

# ── Nginx ports (override for staging; leave defaults for production) ─────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Backup ────────────────────────────────────────────────────────────────────
RCLONE_REMOTE=kasms-backup
BACKUP_STAGING_DIR=/tmp/kasms_offsite
BACKUP_ALERT_EMAIL=kasmsmanagement@gmail.com

# ── Monitoring ────────────────────────────────────────────────────────────────
# Leave SENTRY_DSN empty to disable Sentry (e.g. local dev, staging).
# Set it to your project DSN from sentry.io to enable error tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production